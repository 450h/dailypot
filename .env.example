# =========================================================================
# .env.example: DailyPot has NO secrets and NO API keys. It is fully offline.
# These optional variables exist only for development and tests.
# Legend: [DEV] honoured only in unpackaged builds (!app.isPackaged)
# These are SHELL environment variables: the app does not read a .env file.
#   PowerShell:  $env:DAILYPOT_DATA_DIR = ".dev-data"; npm run dev
#   Git Bash:    DAILYPOT_DATA_DIR=.dev-data npm run dev
# =========================================================================

# Keep dev/test data away from your real data folder (%APPDATA%\DailyPot).
DAILYPOT_DATA_DIR=.dev-data            # [DEV] folder for data.json, security.json, backups/

# Code signing (only if OPEN-QUESTIONS D2 is ever decided). Set as GitHub Actions
# secrets, never in a file:
# CSC_LINK=                            # [CI SECRET] base64 .pfx certificate
# CSC_KEY_PASSWORD=                    # [CI SECRET]
